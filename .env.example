# Copy to .env and fill in. .env is gitignored; never commit real keys.
# The gateway always binds 127.0.0.1 (not configurable).

PORT=8787

# Gemini (OpenAI-compatible endpoint). Key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Ollama (OpenAI-compatible endpoint), no key needed.
OLLAMA_BASE_URL=http://localhost:11434/v1/

# Which provider serves a model: JSON map of model-name prefix -> provider (gemini|ollama).
# Longest matching prefix wins; anything unmatched goes to DEFAULT_PROVIDER.
MODEL_PREFIXES={"gemini-": "gemini"}
DEFAULT_PROVIDER=ollama

# Seconds to wait on an upstream provider before failing the request.
REQUEST_TIMEOUT_SECONDS=120

# SQLite request log.
DB_PATH=data/gateway.db

# Store prompt and response text in the log DB. Off by default for privacy.
LOG_CONTENT=false
