# Copy to .env and fill in. .env is gitignored; never commit real keys.
# The gateway always binds 127.0.0.1 (not configurable).
# Note: variables already set in your Windows environment (e.g. OPENAI_API_KEY) are also read.

PORT=8787

# Providers. All are called through their OpenAI-compatible endpoints.
# A provider with an empty key is off: requests for its models get a clear error.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1/
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1/
# Ollama runs locally and needs no key.
OLLAMA_BASE_URL=http://localhost:11434/v1/

# Which provider serves a model: JSON map of model-name prefix -> provider
# (gemini|openai|anthropic|ollama). Case-insensitive; longest matching prefix wins; anything
# unmatched goes to DEFAULT_PROVIDER. Setting this REPLACES the built-in map, so copy all of it.
# Clients can also pin a provider explicitly with "provider/model", e.g. "ollama/gpt-oss:20b".
MODEL_PREFIXES={"gemini-": "gemini", "gpt-": "openai", "gpt-oss": "ollama", "chatgpt-": "openai", "o1": "openai", "o3": "openai", "o4-": "openai", "claude-": "anthropic"}
DEFAULT_PROVIDER=ollama

# Seconds to wait on an upstream provider before failing the request.
REQUEST_TIMEOUT_SECONDS=120

# Retries of transient upstream failures (connect errors, timeouts, HTTP 429 and 5xx), per
# provider. Waits grow from the base delay, doubling, up to the max. If a provider's Retry-After
# asks for longer than the max, the gateway stops retrying it and falls back instead.
MAX_RETRIES=2
RETRY_BASE_DELAY_SECONDS=0.5
RETRY_MAX_DELAY_SECONDS=8
# JSON map of provider -> model to use when that provider still fails after its retries.
# Only transient failures fall back; a bad request or missing key is returned as-is.
# The model must be pulled in Ollama (`ollama pull qwen2.5`). Set to {} to turn fallback off.
FALLBACK_MODELS={"gemini": "ollama/qwen2.5"}

# SQLite request log.
DB_PATH=data/gateway.db

# Store prompt and response text in the log DB. Off by default for privacy.
LOG_CONTENT=false

# Response cache: an identical request (same model, messages and parameters) within the TTL is
# answered from the DB without calling the provider. Note it stores response text in DB_PATH
# (until it expires) even when LOG_CONTENT=false. Per request, clients can send the header
# `Cache-Control: no-cache` to get a fresh answer, or `no-store` to also not keep it.
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600
