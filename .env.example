# Copy to .env and fill in. .env is gitignored; never commit real keys.
# The gateway always binds 127.0.0.1 (not configurable).
# Note: variables already set in your Windows environment (e.g. OPENAI_API_KEY) are also read.

PORT=8787

# Providers. All are called through their OpenAI-compatible endpoints.
# A provider with an empty key is off: requests for its models get a clear error.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1/
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1/
# Ollama runs locally and needs no key.
OLLAMA_BASE_URL=http://localhost:11434/v1/

# Which provider serves a model: JSON map of model-name prefix -> provider
# (gemini|openai|anthropic|ollama). Case-insensitive; longest matching prefix wins; anything
# unmatched goes to DEFAULT_PROVIDER. Setting this REPLACES the built-in map, so copy all of it.
# Clients can also pin a provider explicitly with "provider/model", e.g. "ollama/gpt-oss:20b".
MODEL_PREFIXES={"gemini-": "gemini", "gpt-": "openai", "gpt-oss": "ollama", "chatgpt-": "openai", "o1": "openai", "o3": "openai", "o4-": "openai", "claude-": "anthropic"}
DEFAULT_PROVIDER=ollama

# Seconds to wait on an upstream provider before failing the request.
REQUEST_TIMEOUT_SECONDS=120

# SQLite request log.
DB_PATH=data/gateway.db

# Store prompt and response text in the log DB. Off by default for privacy.
LOG_CONTENT=false
